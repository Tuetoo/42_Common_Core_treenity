{
    "name": "tree_nity Linux",
    "image": "ubuntu:24.04",
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "remoteUser": "root",
    "postCreateCommand": "apt-get update && apt-get install -y g++ gdb make cmake",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    }
}