{
    "name": "tree_nity Linux",
    "image": "ubuntu:24.04",
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "remoteUser": "root",
    "postCreateCommand": "apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y g++ gdb make cmake libgtest-dev pkg-config && bash .devcontainer/setup.sh",
    "postStartCommand": "bash .devcontainer/display.sh",
    "containerEnv": { "DISPLAY": ":99" },
    "forwardPorts": [6080],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    }
}